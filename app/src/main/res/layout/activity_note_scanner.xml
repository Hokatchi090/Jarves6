<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/notePreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#CC0F1A1F">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <TextView
                android:id="@+id/noteRecognizedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وجّه الكاميرا نحو الورقة أو الشاشة واضغط CAPTURE"
                android:textColor="#D7FBFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/noteCaptureButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="CAPTURE"
                android:textColor="#8DEFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:background="@drawable/hud_glow_card"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/noteSaveButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SAVE NOTE"
                android:textColor="#8DEFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:background="@drawable/hud_glow_card"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
