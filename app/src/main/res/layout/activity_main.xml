<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootHud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14">

    <!-- Hidden compatibility views used internally by MainActivity.kt -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/logText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/statusDot"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="70dp"
        android:paddingEnd="16dp"
        android:background="#10151B">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="J.A.R.V.I.S."
            android:textColor="#8DEFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/topClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#E8FFFF"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Left sidebar navigation -->
    <LinearLayout
        android:id="@+id/sidebarNav"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:background="#10151B">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="HOME"
            android:textColor="#8DEFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawablePadding="4dp"
            android:background="#16232A"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navMap"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="MAP"
            android:textColor="#5C7A82"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_map"
            android:drawablePadding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navLab"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="LAB"
            android:textColor="#5C7A82"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_lab"
            android:drawablePadding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navSys"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="SYS"
            android:textColor="#5C7A82"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_sys"
            android:drawablePadding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navNet"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="NET"
            android:textColor="#5C7A82"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_net"
            android:drawablePadding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navAi"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="AI"
            android:textColor="#5C7A82"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_ai"
            android:drawablePadding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navMore"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="MORE"
            android:textColor="#5C7A82"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:drawableTop="@drawable/ic_nav_more"
            android:drawablePadding="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Live status/log panel (mustawa7 min alHUD al-marja3i: dot + label + ticker) -->
    <LinearLayout
        android:id="@+id/hudStatusPanel"
        android:layout_width="188dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#10151B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/hudStatusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/hudStatusLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NOMINAL"
                android:textColor="#8DEFFF"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.03" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/hudLogScroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/hudLogTicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4E7A82"
                android:textSize="7.5sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Content area (to the right of sidebar, below top bar) -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="72dp"
        android:layout_marginTop="44dp">

        <!-- HOME panel: the existing Jarvis dial -->
        <FrameLayout
            android:id="@+id/homePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/micButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">

                <com.jarvis.assistant.JarvisDialView
                    android:id="@+id/jarvisDial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/micIcon"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- \u062E\u0631\u064A\u0637\u0629 \u0645\u0635\u063A\u0631\u0629 \u062F\u0627\u0626\u0631\u064A\u0629 \u062A\u062F\u0648\u0631 \u0628\u0623\u0633\u0644\u0648\u0628 \u0628\u0644\u0648\u0628\u0631\u0646\u062A\u060C \u062A\u0648\u0631\u064A \u0645\u0648\u0642\u0639\u0643 \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u062A\u062D\u062A \u0627\u0644\u0640 HUD -->
            <!-- زر استماع صريح: يعمل في أي وقت، حتى أثناء كلام جارفس (يقاطعه ويبدأ الاستماع فورًا) -->
            <TextView
                android:id="@+id/listenButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="130dp"
                android:gravity="center"
                android:text="&#127897;&#65039;"
                android:textSize="24sp"
                android:background="@drawable/listen_button_bg"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true" />

            <WebView
                android:id="@+id/miniMapView"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="6dp"
                android:background="@android:color/transparent" />

            <!-- \u0645\u062A\u0635\u0641\u062D \u0635\u063A\u064A\u0631 \u0645\u062F\u0645\u062C \u0644\u0644\u0645\u0648\u0627\u0642\u0639\u060C \u0645\u062E\u0641\u064A \u0628\u0634\u0643\u0644 \u0627\u0641\u062A\u0631\u0627\u0636\u064A\u060C \u064A\u0638\u0647\u0631 \u0628\u062F\u0644 \u0627\u0644\u062E\u0631\u064A\u0637\u0629 \u0639\u0646\u062F \u0641\u062A\u062D \u0645\u0648\u0642\u0639 -->
            <WebView
                android:id="@+id/miniBrowserView"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <!-- MAP panel: real device location -->
        <LinearLayout
            android:id="@+id/mapPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCATION DATA"
                android:textColor="#76E8F5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/hud_glow_card">

                <TextView
                    android:id="@+id/mapLat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAT: --"
                    android:textColor="#D7FBFF"
                    android:textSize="15sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/mapLon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="LON: --"
                    android:textColor="#D7FBFF"
                    android:textSize="15sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/mapStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="TAP TO REQUEST LOCATION"
                    android:textColor="#5C7A82"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/mapOpenExternalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:gravity="center"
                android:text="OPEN IN MAPS"
                android:textColor="#8DEFFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:background="@drawable/hud_glow_card"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- LAB panel: hologram design feature + saved designs -->
        <LinearLayout
            android:id="@+id/labPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESIGN LAB"
                android:textColor="#76E8F5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/labOpenButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="\u0642\u0648\u0644 \u0628\u0635\u0648\u062A\u0643: \u062C\u0627\u0631\u0641\u0633 \u0635\u0645\u0645\u0644\u064A ... (\u0623\u0648 \u0627\u0636\u063A\u0637 \u0647\u0646\u0627 \u0644\u0641\u062A\u062D DESIGN LAB)"
                android:textColor="#5C7A82"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/labProjectsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NO PROJECTS YET"
                    android:textColor="#8AA0A8"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- SYS panel: real device controls -->
        <LinearLayout
            android:id="@+id/sysPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM"
                android:textColor="#76E8F5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/sysBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="BATTERY: --%"
                android:textColor="#D7FBFF"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/sysFlashToggle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="FLASH"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sysCameraButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="CAMERA"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sysSettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SETTINGS"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/sysBluetoothButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="BLUETOOTH"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sysDefenseButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="DEFENSE"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sysScanButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SCAN"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/sysIrButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="IR REMOTE"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sysBackupButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="BACKUP"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sysRestoreButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="RESTORE"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/sysVoiceGenderButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="VOICE: MALE"
                    android:textColor="#A7EAF2"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/sysStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=""
                android:textColor="#5C7A82"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- NET panel: honestly marked unavailable -->
        <LinearLayout
            android:id="@+id/netPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK STATUS"
                android:textColor="#76E8F5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/hud_glow_card">

                <TextView
                    android:id="@+id/netConnectionType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTION: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/netIpAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="IP: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/netWifiName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="WIFI: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/netBluetoothStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="BLUETOOTH: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/netRefreshButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:gravity="center"
                android:text="REFRESH"
                android:textColor="#8DEFFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:background="@drawable/hud_glow_card"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- AI panel: Gemini-backed suggestions -->
        <LinearLayout
            android:id="@+id/aiPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPERATOR PROFILE"
                android:textColor="#76E8F5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/hud_glow_card">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NAME: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="EMAIL: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/profilePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="PHONE: --"
                    android:textColor="#D7FBFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/profileEditButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="EDIT PROFILE"
                    android:textColor="#8DEFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="AI SUGGESTIONS"
                android:textColor="#76E8F5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/aiRefreshButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:gravity="center"
                android:text="TAP TO GENERATE"
                android:textColor="#8DEFFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:background="@drawable/hud_glow_card"
                android:clickable="true"
                android:focusable="true" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/aiSuggestionsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#8AA0A8"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="8dp"
                    android:padding="12dp"
                    android:background="@drawable/hud_glow_card" />
            </ScrollView>
        </LinearLayout>

        <!-- MORE panel: \u0632\u0631 \u062D\u0642\u064A\u0642\u064A \u0644\u0643\u0644 \u0645\u064A\u0632\u0629 (\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0634\u062E\u0635\u064A\u0629 + \u0627\u0644\u062C\u064A\u0648\u0644\u0648\u062C\u064A\u0627) -->
        <ScrollView
            android:id="@+id/morePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0634\u062E\u0635\u064A\u0629"
                    android:textColor="#76E8F5"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/moreFakeCallButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="FAKE CALL"
                    android:textColor="#A7EAF2"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/moreSendLocationButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="SEND SOS LOCATION"
                    android:textColor="#A7EAF2"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/moreRecordStartButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="REC START"
                        android:textColor="#A7EAF2"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hud_glow_card"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/moreRecordStopButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="REC STOP"
                        android:textColor="#A7EAF2"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hud_glow_card"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/moreDefenseInfoButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="SELF-DEFENSE INFO"
                    android:textColor="#A7EAF2"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/hud_glow_card"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="\u0627\u0644\u062C\u064A\u0648\u0644\u0648\u062C\u064A\u0627"
                    android:textColor="#76E8F5"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/moreFieldListButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="FIELD LOG"
                        android:textColor="#A7EAF2"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hud_glow_card"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/moreFieldExportButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="EXPORT CSV"
                        android:textColor="#A7EAF2"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hud_glow_card"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/moreCompassButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="COMPASS"
                        android:textColor="#A7EAF2"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hud_glow_card"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/moreStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text=""
                    android:textColor="#5C7A82"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Small circular button that toggles the sidebar's visibility.
         Placed last so it always renders on top of both the top bar and the sidebar. -->
    <TextView
        android:id="@+id/sidebarToggle"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="17dp"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="\u2261"
        android:textColor="#8DEFFF"
        android:textSize="15sp"
        android:clickable="true"
        android:focusable="true" />

    <!-- \u0645\u0631\u0627\u0642\u0628 \u0627\u0644\u0623\u062F\u0627\u0621: FPS + \u0627\u0644\u0630\u0627\u0643\u0631\u0629. \u064A\u0638\u0647\u0631 \u0641\u064A Debug \u0628\u0646\u0627\u0621 \u0641\u0642\u0637 (\u0645\u062E\u0641\u064A \u0628\u0634\u0643\u0644 \u0627\u0641\u062A\u0631\u0627\u0636\u064A) -->
    <TextView
        android:id="@+id/perfMonitor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="128dp"
        android:layout_marginEnd="8dp"
        android:text="FPS: -- | MEM: -- MB"
        android:textColor="#4A808A"
        android:textSize="8sp"
        android:fontFamily="monospace"
        android:background="#80101820"
        android:padding="4dp"
        android:visibility="gone" />

</FrameLayout>
