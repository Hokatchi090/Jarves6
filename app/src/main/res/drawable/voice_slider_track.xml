<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#101B20" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#2A4A52" />
            <size android:height="10dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#1560A8"
                    android:centerColor="#2E9FD6"
                    android:endColor="#6FE3F5" />
                <corners android:radius="6dp" />
                <size android:height="10dp" />
            </shape>
        </clip>
    </item>
</layer-list>
